DATABASE_URL=postgres://starter:starter@localhost:5432/starter

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# The request header with the client's IP, for sign-in rate limits. Use the one
# header your host overwrites: cf-connecting-ip on Cloudflare. Default: x-forwarded-for
CLIENT_IP_HEADER=

# Emails that can open /admin, separated by commas. Matched without regard to case.
ADMIN_EMAILS=

# Server logs. Level: debug, info, warn or error. Default: info. Format: json
# (one JSON object per line) or pretty. Default: json in production, else pretty.
LOG_LEVEL=
LOG_FORMAT=

# Sentry error tracking. Leave the DSN empty to turn it off. It's read at build time too.
NEXT_PUBLIC_SENTRY_DSN=
# Build time only: with a token, the build uploads source maps for readable stack traces.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Vercel Web Analytics: set to 1 to count page views. Works only on Vercel. Read at build time.
NEXT_PUBLIC_VERCEL_ANALYTICS=
# Vercel Speed Insights: set to 1 to measure Core Web Vitals from real visits. Works only on Vercel. Read at build time.
NEXT_PUBLIC_VERCEL_SPEED_INSIGHTS=

# Google OAuth. Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile on magic-link sign-in. Set both or neither; empty turns it off.
# The site key is read at build time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend. Without a key, emails are logged to the server console (not allowed in production).
RESEND_API_KEY=
EMAIL_FROM=starter <onboarding@resend.dev>

# Payments. stripe or waffo; leave empty to turn buying off.
PAYMENT_PROVIDER=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Waffo Pancake. Put the PEM key on one line with \n between lines.
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
# Credit packs: one one-time product per pack in CREDIT_PACKS.
WAFFO_PACK_SMALL_PRODUCT_ID=
WAFFO_PACK_MEDIUM_PRODUCT_ID=
WAFFO_PACK_LARGE_PRODUCT_ID=
# Subscriptions: a monthly product, and the store for portal links.
WAFFO_SUBSCRIPTION_PRODUCT_ID=
WAFFO_STORE_ID=
# Yearly plans: a yearly product. Empty hides the yearly plans.
WAFFO_SUBSCRIPTION_YEARLY_PRODUCT_ID=
WAFFO_ENVIRONMENT=test

# DeepSeek for AI chat. Leave empty to turn chat off.
DEEPSEEK_API_KEY=
# Default: deepseek-flash
DEEPSEEK_MODEL=

# Image generation with Alibaba Cloud Model Studio (Bailian). Leave empty to
# turn it off. Needs the storage below.
DASHSCOPE_API_KEY=
# Beijing by default. Keys only work in the region they were created in.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_IMAGE_MODEL=wan2.6-t2i
# Image-to-video with VIDEO_PROVIDER=dashscope. Default: wan2.7-i2v-2026-04-25
DASHSCOPE_VIDEO_MODEL=

# Image-to-video: fal (Kling 2.6 Pro), seeapi (Seedance 2.0) or dashscope
# (Bailian Wan 2.7, uses the DASHSCOPE_* settings above). Leave
# VIDEO_PROVIDER empty to turn it off. Needs the storage below; SeeAPI also
# needs the bucket reachable from the internet, so not the local MinIO.
VIDEO_PROVIDER=
FAL_KEY=
SEEAPI_API_KEY=
# Screen image/video prompts with Waffo before spending credits. Needs WAFFO_MERCHANT_ID and WAFFO_PRIVATE_KEY.
PROMPT_MODERATION=
# seeapi checks each video start image and each photo of a two-photo video with SeeAPI's NSFW
# filter before it spends credits. Needs SEEAPI_API_KEY and, like SeeAPI
# video, a bucket reachable from the internet. Empty turns the check off.
IMAGE_MODERATION=

# S3-compatible storage (R2, Alibaba Cloud OSS, S3). These match the MinIO
# in compose.yaml.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=starter
STORAGE_ACCESS_KEY_ID=starter
STORAGE_SECRET_ACCESS_KEY=starter-secret
STORAGE_FORCE_PATH_STYLE=true

# Bearer token for POST /api/cron/sweep, which refunds abandoned images and
# videos. Generate with: openssl rand -base64 32. Empty closes the route.
CRON_SECRET=

# IndexNow key (8-128 letters, digits or hyphens), served at /indexnow.txt.
# POST /api/indexnow with the CRON_SECRET bearer sends the sitemap to Bing
# and other IndexNow engines. Generate with: openssl rand -hex 16. Empty
# turns IndexNow off.
INDEXNOW_KEY=

# PostHog pageviews and business events. Public project token, never a personal API key.
# Set both; US host https://us.i.posthog.com, EU host https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
